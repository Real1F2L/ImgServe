# ImgServe Server Options
# This file is expected to be inside the working directory

# Server url is used to generate image urls
server_url: SERVER_URL_HERE

CORS_origins: [
  "http://localhost",
  "http://127.0.0.1",

  # Add your website address here
  "https://www.example.com
]

# Change the docker mount instead of these values!
image_location: "./Library/"
cache_location: "./Cache/"

# Disables deleting cached images
cache_persists: false
keep_cache_for_hours: 24 # Set to -1 to disable
purge_cache_time: "00:00:00" # The time of day to purge cache (Default midnight)

# Updating statistics may cause a lot of reads to disk at once depending on the size of your library. Set to -1 to disable.
update_statistics_every_minutes: 10